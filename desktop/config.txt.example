# ===== 변환기 설정 =====  (이 파일을 config.txt 로 복사한 뒤 값을 채우세요)
# 인증키는 앱 안에서 직접 입력·저장할 수도 있어요. 이 파일을 꼭 손댈 필요는 없습니다.

# ----- 엔진 -----
# kakao  = 기본. 빠르고(초당 33건) 일일 한도 10만건. PNU·좌표·도로명주소·건물명.
# vworld = 느리고(초당 14건) 일일 한도 4만건. 대신 필지 경계·공시지가는 이쪽만 됩니다.
ENGINE=kakao

# ----- 카카오 REST 키 (ENGINE=kakao 일 때 필수) -----
# developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
#  ※ 같은 화면에서 "카카오맵" 제품을 반드시 활성화하세요. 안 하면 403 오류가 납니다.
#  ※ 대표 도메인은 http://localhost 로 둬도 됩니다.
KAKAO_KEY=여기에_카카오_REST_API_키_붙여넣기

# ----- VWorld 인증키 -----
# 필지·공시지가를 쓰거나, 카카오가 못 찾은 주소를 보완할 때 필요합니다(없으면 그 기능만 꺼짐).
# vworld.kr → 오픈API → 인증키 발급(무료).
#  · 활용 API 에 "2D 데이터 API" 체크, 사이트 URL 은 http://localhost
API_KEY=여기에_VWorld_인증키_붙여넣기

# 공시지가·필지 조회 시 데이터 API 도메인 (키 등록 URL과 동일하게)
DOMAIN=localhost

# ----- 동시에 조회하는 개수 -----
# 카카오는 동시 접속에 관대해서 10 정도까지 올려도 됩니다.
# VWorld 는 너무 크면 연결을 끊어 실패가 늘어요 → 4~6 권장, '통신실패'가 많으면 더 줄이세요.
WORKERS=10
